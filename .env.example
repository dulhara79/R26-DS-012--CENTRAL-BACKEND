# ---------------------------------------------------------------------------
# THE ONLY FILE YOU CHANGE WHEN THE HUGGING FACE SPACES GO LIVE.
# Leave a URL blank -> that service runs in MOCK mode and the system still works.
# Paste a URL in -> restart -> that service is live. Nothing else changes.
# ---------------------------------------------------------------------------
C1_BASE_URL=
C2_BASE_URL=
C4_BASE_URL=
FUSION_BASE_URL=
C3_BASE_URL=

# Example once live:
# C4_BASE_URL=https://dulharakaushalya-tc-wpn-demo.hf.space

# Override only if a teammate refuses to use /predict
C1_PREDICT_PATH=/predict
C2_PREDICT_PATH=/predict
C4_PREDICT_PATH=/predict
FUSION_PREDICT_PATH=/fuse
C3_PREDICT_PATH=/intervene

# Server-side only. NEVER in an APK.
HF_TOKEN=

DATABASE_URL=sqlite:///./clinanx.db
# DATABASE_URL=postgresql+psycopg://user:pass@host/db

JWT_SECRET=change-me-before-you-deploy
JWT_TTL_MIN=720
MRN_PEPPER=change-me-too

HTTP_TIMEOUT_S=90
HTTP_RETRIES=2

# Fusion. Freeze these before you write the paper.
C3_MODE=downstream
W_C1=0.31
W_C2=0.24
W_C4=0.45
MIN_MODALITIES=2
FUSION_WEIGHTS_VERSION=fusion-weights-v1.0.0

FRESH_C1_SECONDS=900
FRESH_C2_SECONDS=604800
FRESH_C4_SECONDS=7776000
C2_DAYS_REQUIRED=42
